# Stage 1: Build static web assets
FROM node:22-alpine AS builder

WORKDIR /app

# Install pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy package manifests and lockfile
COPY package.json pnpm-workspace.yaml ./
COPY client/gui/package.json ./client/gui/

# Install workspace dependencies
RUN pnpm install --ignore-scripts

# Copy source code
COPY . .

# Build GUI static web assets
RUN pnpm --filter sayodb-gui build

# Stage 2: Ultra-lightweight Nginx web server
FROM nginx:alpine AS runner

# Copy compiled static assets into Nginx web root
COPY --from=builder /app/client/gui/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]