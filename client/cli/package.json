{
  "name": "sayodb",
  "version": "0.1.5",
  "description": "In-memory vector store and key-value database with zero-OOM spilling",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "bin": {
    "sayodb": "dist/cli.js",
    "sayodb-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "sayodb": "tsx src/cli.ts",
    "build": "tsup && chmod +x dist/cli.js dist/cli.mjs",
    "prepublishOnly": "pnpm run build",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "database",
    "in-memory",
    "redis",
    "cache",
    "vector-store",
    "ai",
    "sayodb",
    "cli",
    "mongoose",
    "driver",
    "sdk"
  ],
  "author": "sayoDB Team",
  "license": "MIT",
  "dependencies": {
    "@sayodb/client": "^0.1.2",
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
