{
  "name": "sayodb-server",
  "version": "0.1.0",
  "description": "Production-grade in-memory Redis-like database engine in TypeScript",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "redis",
    "in-memory",
    "database",
    "typescript",
    "resp",
    "kv-store"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "pino-pretty": "^11.0.0",
    "tsup": "^8.0.2",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
